# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://erp_user:STRONG_PASSWORD@localhost:5432/erp_db
# Set to "true" if your DB provider requires SSL (Supabase, Railway, Neon)
DATABASE_SSL=false

# ─── App ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://your-frontend.vercel.app
# Main browser frontend. Use an exact origin, without wildcard.
FRONTEND_URL=https://your-frontend.vercel.app

# ─── Auth ───────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_BYTE_HEX
JWT_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────────────────
# Comma-separated exact additional origins (for example, an explicitly
# approved Vercel preview). Localhost is ignored when NODE_ENV=production.
# Never use "*" or "*.vercel.app".
CORS_ORIGINS=https://your-frontend.vercel.app

# Legacy demo records are disabled by default so a fresh/reset database stays
# empty. Enable only once when intentionally importing the old WebRand dataset.
FINANCE_SEED_LEGACY_DATA=false

# ─── Email (Brevo) ───────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=noreply@your-domain.com

# ─── Telegram Bot ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ─── AI Assistant (Google Gemini — free) ────────────────
# Get free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
