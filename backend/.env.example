# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://erp_user:STRONG_PASSWORD@localhost:5432/erp_db
# Set to "true" if your DB provider requires SSL (Supabase, Railway, Neon)
DATABASE_SSL=false

# ─── App ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://your-frontend.vercel.app
# Main browser frontend. Use an exact origin, without wildcard.
FRONTEND_URL=https://your-frontend.vercel.app
# Публичный адрес API (для ссылок на файлы «Директа», которые забирает Instagram).
# Пусто — берётся из адреса входящего запроса.
PUBLIC_API_URL=
# Адрес, по которому голосовой бот ходит в API этого же сервера.
# Пусто — http://127.0.0.1:$PORT/api.
INTERNAL_API_URL=
# Swagger в production выключен; "true" — включить временно для отладки.
ENABLE_SWAGGER=
# Папка загрузок (по умолчанию ./uploads; на Railway — смонтированный том).
UPLOADS_DIR=
# Путь к ffmpeg (голосовые для Instagram). Пусто — "ffmpeg" из PATH.
FFMPEG_PATH=

# ─── Auth ───────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_BYTE_HEX
# JWT_EXPIRES_IN — НЕ используется: рабочий токен бессрочный по решению
# владельца (см. auth.module.ts). Переменную можно удалить из окружения.
# JWT_EXPIRES_IN=7d
# Ключ шифрования сохранённых паролей клиентов (secret-box). Без него ключ
# выводится из JWT_SECRET — и смена JWT_SECRET сделает уже зашифрованные
# значения нечитаемыми. Перед сменой JWT_SECRET задайте ENCRYPTION_KEY
# равным ТЕКУЩЕМУ значению JWT_SECRET, после этого JWT_SECRET можно менять.
ENCRYPTION_KEY=

# ─── CORS ───────────────────────────────────────────────
# Comma-separated exact additional origins (for example, an explicitly
# approved Vercel preview). Localhost is ignored when NODE_ENV=production.
# Never use "*" or "*.vercel.app".
CORS_ORIGINS=https://your-frontend.vercel.app

# Legacy demo records are disabled by default so a fresh/reset database stays
# empty. Enable only once when intentionally importing the old WebRand dataset.
FINANCE_SEED_LEGACY_DATA=false

# Демо-данные (npm run seed) при NODE_ENV=production запускаются только с
# SEED_ALLOW=1. На рабочей базе не нужно никогда.
SEED_ALLOW=

# BACKUP_PASSPHRASE — НЕ переменная бэкенда, а секрет GitHub Actions
# (Settings → Secrets → Actions): им шифруется ежедневный бэкап базы
# (.github/workflows/db-backup.yml). Без него бэкап выкладывается открытым.

# ─── Email (Brevo) ───────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM=noreply@your-domain.com

# ─── Telegram Bot ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Имя бота для ссылок t.me/<бот>; пусто — узнаём через getMe.
TELEGRAM_BOT_USERNAME=
# "false" — не ставить вебхук бота автоматически при старте в production.
TELEGRAM_WEBHOOK_AUTOSET=

# ─── Мобильные пуши (Firebase Cloud Messaging) ──────────
# JSON сервисного аккаунта Firebase одной строкой. Пусто — пуши выключены.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── AI Assistant (Google Gemini — free) ────────────────
# Get free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# Модель Gemini (по умолчанию gemini-2.5-flash).
GEMINI_MODEL=

# ─── Голосовой бот / ИИ-провайдеры ──────────────────────
# OpenAI — основной провайдер, если ключ задан.
OPENAI_API_KEY=
# Модель чата (по умолчанию gpt-5.4-mini).
OPENAI_MODEL=
# "chat" — старый Chat Completions вместо Responses API.
OPENAI_API_MODE=
# Глубина рассуждений модели (low / medium / high); пусто — по модели.
OPENAI_REASONING=
# Модель распознавания речи (по умолчанию gpt-4o-transcribe).
OPENAI_TRANSCRIBE_MODEL=
# Groq — запасной провайдер.
GROQ_API_KEY=
# Модель чата Groq (по умолчанию openai/gpt-oss-120b).
GROQ_MODEL=
# Модель распознавания речи Groq (по умолчанию whisper-large-v3).
GROQ_TRANSCRIBE_MODEL=

# ─── Instagram «Директ» и вебхуки Meta ──────────────────
# Токен доступа Instagram-аккаунта.
INSTAGRAM_ACCESS_TOKEN=
# ID аккаунта; пусто — узнаём сами через /me.
INSTAGRAM_ACCOUNT_ID=
# Адрес Graph API; пусто — graph.instagram.com/v26.0.
INSTAGRAM_API_URL=
# Секрет приложения Instagram — им подписаны вебхуки.
INSTAGRAM_APP_SECRET=
# Слово для проверки адреса вебхука Meta.
META_VERIFY_TOKEN=
