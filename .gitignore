node_modules/
dist/

# Environment — never commit real secrets
.env
.env.local
.env.production
.env.*.local
backend/.env
frontend/.env
# Keep .env.example (template without secrets)
!.env.example
!backend/.env.example
!frontend/.env.example

*.log
uploads/
.DS_Store
coverage/

# Локальные настройки Claude Code (могут содержать секреты в allowlist) —
# НИКОГДА не коммитить.
.claude/settings.local.json

# Firebase service account (секретный ключ FCM-пушей) — НИКОГДА не коммитить.
firebase-service-account.json
*service-account*.json

# Одноразовые скрипты отладки и сидинга в корне backend (_repro_*, _seed_*
# и т.п.). В них регулярно оказываются строки подключения и тестовые пароли
# открытым текстом — правило не даёт закоммитить их случайным `git add .`.
/backend/_*.js
/backend/_*.ts
